{
  "name": "m2-academic-gpu-policy-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "vitest run test/atdd test/harness test/implementation",
    "test:harness": "vitest run test/harness",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/main.ts",
    "cli": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/adapters/inbound/cli.ts",
    "setup": "npm ci --ignore-scripts && npm run check",
    "lint": "node test/ci/implementation-lint.mjs"
  },
  "devDependencies": {
    "vitest": "^4.0.0",
    "typescript": "^5.9.0",
    "fast-check": "^4.3.0",
    "@types/node": "^24.0.0",
    "yaml": "^2.8.0"
  }
}
